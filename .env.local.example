# Copie ce fichier en .env.local et renseigne tes clés Supabase
# (Project Settings > API dans ton dashboard Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé API Groq pour Céleste, la mascotte-assistante (console.groq.com — gratuit,
# aucune carte bancaire requise, héberge des modèles Llama).
# Utilisée UNIQUEMENT côté serveur (app/api/celeste/route.ts) : jamais exposée
# au navigateur, contrairement aux clés NEXT_PUBLIC_ ci-dessus.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
